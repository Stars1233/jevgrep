    "remotion": "4.0.529",
    "@react-three/fiber": "^9.8.1",
    "@remotion/three": "4.0.529",
    "three": "^0.186.1",
    "postprocessing": "^6.39.5",
    "n8ao": "^2.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^5.9.3",
    "@types/three": "^0.186.0"
  }
